{
  "schema_id": "money_credit_v1",
  "section_name": "Деньги/кредиты",
  "version": 1,
  "steps": [
    {
      "step_id": "residency_gate",
      "kind": "choice",
      "field_name": "resides_in_portugal",
      "prompt": "Вы или ваш бизнес находитесь в Португалии?",
      "required": true,
      "options": [
        {
          "value": "yes",
          "aliases": [
            "да",
            "yes",
            "y"
          ]
        },
        {
          "value": "no",
          "aliases": [
            "нет",
            "no",
            "n"
          ]
        }
      ],
      "stop_if_negative": true
    },
    {
      "step_id": "geo_tags",
      "kind": "choice",
      "field_name": "geo_tags",
      "prompt": "Выберите город, где вы работаете.\n\nЕсли это один город — нажмите кнопку с городом ниже или «Онлайн».\nЕсли это несколько городов или вашего города нет в списке — нажмите «Несколько / другой город» и там впишите все нужные города вручную.\n\nВажно: локация указывается только на этом шаге, в текст объявления её добавлять запрещено!",
      "required": true,
      "options": [
        {
          "value": "lisboa",
          "label": "Lisboa"
        },
        {
          "value": "porto",
          "label": "Porto"
        },
        {
          "value": "coimbra",
          "label": "Coimbra"
        },
        {
          "value": "braga",
          "label": "Braga"
        },
        {
          "value": "faro",
          "label": "Faro"
        },
        {
          "value": "sintra",
          "label": "Sintra"
        },
        {
          "value": "cascais",
          "label": "Cascais"
        },
        {
          "value": "leiria",
          "label": "Leiria"
        },
        {
          "value": "setubal",
          "label": "Setúbal"
        },
        {
          "value": "online",
          "label": "Онлайн"
        },
        {
          "value": "custom",
          "label": "Несколько / другой город"
        }
      ],
      "validation": {
        "max_len": 200
      }
    },
    {
      "step_id": "description",
      "kind": "text",
      "field_name": "description",
      "prompt": "Опишите свои услуги и всё важное для потенциальных клиентов.\n\nПока не указывайте ссылки и контакты, их можно будет добавить на следующих шагах.\n\nМожно писать подробно. Если позже выберете публикацию с фото/видео, бот отдельно проверит, помещается ли текст в лимит подписи Telegram:",
      "required": true,
      "validation": {
        "max_len": 600
      }
    },
    {
      "step_id": "social_links",
      "kind": "text",
      "field_name": "social_links",
      "prompt": "Вставьте ссылки на соцсети или сайты, если они есть:",
      "required": false,
      "validation": {
        "max_len": 1200
      }
    },
    {
      "step_id": "phone_main",
      "kind": "phone",
      "field_name": "phone_main",
      "prompt": "Укажите португальский номер телефона для основной связи, начиная с +351.",
      "required": true,
      "validation": {
        "regex": "^\\+351\\d{9}$"
      }
    },
    {
      "step_id": "phone_whatsapp",
      "kind": "phone",
      "field_name": "phone_whatsapp",
      "prompt": "Укажите номер телефона, к которому привязан WhatsApp для резервной связи, если отличается от основного. Можно оставить пустым.",
      "required": false,
      "validation": {
        "regex": "^\\+\\d+$"
      }
    },
    {
      "step_id": "contact_name",
      "kind": "text",
      "field_name": "contact_name",
      "prompt": "Укажите имя, название компании или имя представителя:",
      "required": true,
      "validation": {
        "max_len": 300
      }
    }
  ]
}
